{
  "name": "UNDERTALE Launcher // Pixel Edition",
  "short_name": "UTL Launcher",
  "description": "Unofficial fan-made Undertale launcher with pixel touch controls, an original SOUL TRIAL demo and a GameBanana mod browser.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "any",
  "lang": "ru",
  "dir": "ltr",
  "background_color": "#07060c",
  "theme_color": "#08070d",
  "categories": ["games", "entertainment"],
  "icons": [
    {
      "src": "./assets/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-120.png",
      "sizes": "120x120",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
